  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "n8ao": "2.0.1",
    "playwright-core": "1.56.1",
    "prettier": "3.8.1",
    "sharp": "0.35.5",
    "three": "0.185.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "3.2.7"
